<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="administrator" method="upgrade">
	<name>MOD_MOTHERSHIP_INVOICES</name>
	<author>Trevor Bice</author>
	<creationDate>2026-08</creationDate>
	<copyright>(C) 2026 Trevor Bice</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>trevorbicewebdesign@gmail.com</authorEmail>
	<authorUrl>webdesign.trevorbice.com</authorUrl>
	<version>1.0.0</version>
	<description>MOD_MOTHERSHIP_INVOICES_XML_DESCRIPTION</description>
	<namespace path="src">TrevorBice\Module\MothershipInvoices</namespace>
	<files>
		<folder module="mod_mothership_invoices">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_mothership_invoices.ini</language>
		<language tag="en-GB">language/en-GB/mod_mothership_invoices.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="limit"
					type="number"
					label="MOD_MOTHERSHIP_INVOICES_FIELD_LIMIT_LABEL"
					description="MOD_MOTHERSHIP_INVOICES_FIELD_LIMIT_DESC"
					default="5"
					filter="integer"
					min="1"
					max="50"
					validate="number"
				/>

				<field
					name="show_summary"
					type="radio"
					label="MOD_MOTHERSHIP_INVOICES_FIELD_SHOW_SUMMARY_LABEL"
					layout="joomla.form.field.radio.switcher"
					default="1"
					filter="integer"
					>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
					validate="moduleLayout"
				/>

				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="3"
					validate="CssIdentifier"
				/>

				<field
					name="cache"
					type="list"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					default="0"
					filter="integer"
					validate="options"
					>
					<option value="1">JGLOBAL_USE_GLOBAL</option>
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>

				<field
					name="cache_time"
					type="number"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					default="900"
					filter="integer"
					min="1"
					validate="number"
				/>

				<field
					name="cachemode"
					type="hidden"
					default="static"
					>
					<option value="static"></option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
