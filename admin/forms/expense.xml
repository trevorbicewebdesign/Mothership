<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="TrevorBice\Component\Mothership\Administrator\Field">
	<fieldset name="details">
		<field name="id" type="text" default="0" readonly="true" class="readonly" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC" />

		<field name="item" type="text" default="" required="true" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_ITEM_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_ITEM_DESC" />

		<field name="merchant" type="text" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_MERCHANT_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_MERCHANT_DESC" />

		<field name="category" type="list" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_CATEGORY_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_CATEGORY_DESC">
			<option value="">COM_MOTHERSHIP_EXPENSE_CATEGORY_SELECT</option>
			<option value="SOFTWARE">COM_MOTHERSHIP_EXPENSE_CATEGORY_SOFTWARE</option>
			<option value="EQUIPMENT">COM_MOTHERSHIP_EXPENSE_CATEGORY_EQUIPMENT</option>
			<option value="WEBHOST">COM_MOTHERSHIP_EXPENSE_CATEGORY_WEBHOST</option>
			<option value="INTERNET">COM_MOTHERSHIP_EXPENSE_CATEGORY_INTERNET</option>
			<option value="CELL">COM_MOTHERSHIP_EXPENSE_CATEGORY_CELL</option>
			<option value="ADVERTISING">COM_MOTHERSHIP_EXPENSE_CATEGORY_ADVERTISING</option>
			<option value="FEE">COM_MOTHERSHIP_EXPENSE_CATEGORY_FEE</option>
			<option value="BANK">COM_MOTHERSHIP_EXPENSE_CATEGORY_BANK</option>
			<option value="CONTRACT">COM_MOTHERSHIP_EXPENSE_CATEGORY_CONTRACT</option>
			<option value="RENT">COM_MOTHERSHIP_EXPENSE_CATEGORY_RENT</option>
			<option value="POWER">COM_MOTHERSHIP_EXPENSE_CATEGORY_POWER</option>
			<option value="UTILITIES">COM_MOTHERSHIP_EXPENSE_CATEGORY_UTILITIES</option>
			<option value="TRAVEL">COM_MOTHERSHIP_EXPENSE_CATEGORY_TRAVEL</option>
			<option value="TAXES">COM_MOTHERSHIP_EXPENSE_CATEGORY_TAXES</option>
			<option value="OTHER">COM_MOTHERSHIP_EXPENSE_CATEGORY_OTHER</option>
		</field>

		<field name="amount" type="text" default="0.00" required="true" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_AMOUNT_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_AMOUNT_DESC" />

		<field name="expense_date" type="calendar" default="" class="validate-date"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_DATE_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_DATE_DESC"
			format="%Y-%m-%d" filter="none" />

		<field name="transaction_id" type="text" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_TRANSACTION_ID_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_TRANSACTION_ID_DESC" />

		<field name="payment_account" type="text" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_PAYMENT_ACCOUNT_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_PAYMENT_ACCOUNT_DESC"
			hint="COM_MOTHERSHIP_FIELD_EXPENSE_PAYMENT_ACCOUNT_HINT" />

		<field name="receipt_import" type="hidden" default="" filter="alnum" />

		<field name="description" type="textarea" rows="4" cols="50" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_DESCRIPTION_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_DESCRIPTION_DESC" />
	</fieldset>

	<fieldset name="assignment">
		<field name="client_id" type="clientlist" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_CLIENT_ID_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_CLIENT_ID_DESC" />

		<field name="account_id" type="accountlist" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_ACCOUNT_ID_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_ACCOUNT_ID_DESC" />

		<field name="project_id" type="projectlist" default="" class="input-xxlarge"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_PROJECT_ID_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_PROJECT_ID_DESC" />

		<field name="billable" type="radio" default="0" class="btn-group btn-group-yesno"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_BILLABLE_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_BILLABLE_DESC">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field name="reimbursed" type="radio" default="0" class="btn-group btn-group-yesno"
			label="COM_MOTHERSHIP_FIELD_EXPENSE_REIMBURSED_LABEL" description="COM_MOTHERSHIP_FIELD_EXPENSE_REIMBURSED_DESC">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset name="metadata">
		<field name="created_at" type="calendar" default="" readonly="true" class="validate-date"
			label="COM_MOTHERSHIP_FIELD_CREATED_AT_LABEL" description="COM_MOTHERSHIP_FIELD_CREATED_AT_DESC"
			format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<field name="updated_at" type="calendar" default="" readonly="true" class="validate-date"
			label="COM_MOTHERSHIP_FIELD_UPDATED_AT_LABEL" description="COM_MOTHERSHIP_FIELD_UPDATED_AT_DESC"
			format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
	</fieldset>
</form>
