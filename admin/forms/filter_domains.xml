<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="TrevorBice\Component\Mothership\Administrator\Field">
	<fields name="filter">
		<field name="search" type="text" inputmode="search" label="COM_MOTHERSHIP_DOMAINS_FILTER_SEARCH_LABEL" description="COM_MOTHERSHIP_DOMAINS_FILTER_SEARCH_DESC" hint="JSEARCH_FILTER" />

		<field name="client_id" type="sql" default="" onchange="this.form.submit();"
			header="COM_MOTHERSHIP_FILTER_SELECT_CLIENT" key_field="value" value_field="text"
			query="SELECT id AS value, name AS text FROM #__mothership_clients ORDER BY name ASC"
			label="COM_MOTHERSHIP_FILTER_CLIENT_LABEL" description="" />

		<field name="account_id" type="accountfilter" default="" onchange="this.form.submit();"
			label="COM_MOTHERSHIP_FILTER_ACCOUNT_LABEL" description="" />
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" statuses="*,0,1,2,-2" class="js-select-submit-on-change" default="a.name ASC" validate="options">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="a.name ASC">COM_MOTHERSHIP_HEADING_DOMAIN_NAME_ASC</option>
			<option value="a.name DESC">COM_MOTHERSHIP_HEADING_DOMAIN_NAME_DESC</option>
			<option value="c.name ASC">COM_MOTHERSHIP_HEADING_DOMAIN_CLIENT_NAME_ASC</option>
			<option value="c.name DESC">COM_MOTHERSHIP_HEADING_DOMAIN_CLIENT_NAME_DESC</option>
			<option value="a.created ASC">COM_MOTHERSHIP_HEADING_DOMAIN_CREATED_ASC</option>
			<option value="a.created DESC">COM_MOTHERSHIP_HEADING_DOMAIN_CREATED_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" class="js-select-submit-on-change" />
	</fields>
</form>
