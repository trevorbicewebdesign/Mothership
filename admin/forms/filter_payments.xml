<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="TrevorBice\Component\Mothership\Administrator\Field">
	<fields name="filter">
		<field name="search" type="text" inputmode="search" label="COM_MOTHERSHIP_PAYMENTS_FILTER_SEARCH_LABEL" description="COM_MOTHERSHIP_PAYMENTS_FILTER_SEARCH_DESC" hint="JSEARCH_FILTER" />

		<field name="client_id" type="sql" default="" onchange="this.form.submit();"
			header="COM_MOTHERSHIP_FILTER_SELECT_CLIENT" key_field="value" value_field="text"
			query="SELECT id AS value, name AS text FROM #__mothership_clients ORDER BY name ASC"
			label="COM_MOTHERSHIP_FILTER_CLIENT_LABEL" description="" />

		<field name="account_id" type="accountfilter" default="" onchange="this.form.submit();"
			label="COM_MOTHERSHIP_FILTER_ACCOUNT_LABEL" description="" />

		<field name="payment_method" type="sql" default="" onchange="this.form.submit();"
			header="COM_MOTHERSHIP_FILTER_SELECT_METHOD" key_field="value" value_field="text"
			query="SELECT DISTINCT payment_method AS value, payment_method AS text FROM #__mothership_payments WHERE payment_method IS NOT NULL AND payment_method &lt;&gt; '' ORDER BY payment_method ASC"
			label="COM_MOTHERSHIP_PAYMENTS_FILTER_METHOD_LABEL" description="" />

		<field name="status" type="list" default="" onchange="this.form.submit();"
			label="COM_MOTHERSHIP_PAYMENTS_FILTER_STATUS_LABEL" description="">
			<option value="">COM_MOTHERSHIP_FILTER_SELECT_STATUS</option>
			<option value="1">COM_MOTHERSHIP_PAYMENT_STATUS_PENDING</option>
			<option value="2">COM_MOTHERSHIP_PAYMENT_STATUS_COMPLETED</option>
			<option value="3">COM_MOTHERSHIP_PAYMENT_STATUS_FAILED</option>
			<option value="4">COM_MOTHERSHIP_PAYMENT_STATUS_CANCELLED</option>
			<option value="5">COM_MOTHERSHIP_PAYMENT_STATUS_REFUNDED</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" statuses="*,0,1,2,-2" class="js-select-submit-on-change" default="p.payment_date DESC" validate="options">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="p.created_at DESC">COM_MOTHERSHIP_HEADING_PAYMENT_CREATED_DESC</option>
			<option value="p.created_at ASC">COM_MOTHERSHIP_HEADING_PAYMENT_CREATED_ASC</option>
			<option value="p.payment_date DESC">Payment date (newest first)</option>
			<option value="p.payment_date ASC">Payment date (oldest first)</option>
			<option value="c.name ASC">COM_MOTHERSHIP_HEADING_PAYMENT_CLIENT_NAME_ASC</option>
			<option value="c.name DESC">COM_MOTHERSHIP_HEADING_PAYMENT_CLIENT_NAME_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" class="js-select-submit-on-change" />
	</fields>
</form>