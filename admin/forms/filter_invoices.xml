<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="TrevorBice\Component\Mothership\Administrator\Field">
	<fields name="filter">
		<field name="search" type="text" inputmode="search" label="COM_MOTHERSHIP_INVOICES_FILTER_SEARCH_LABEL" description="COM_MOTHERSHIP_INVOICES_FILTER_SEARCH_DESC" hint="JSEARCH_FILTER" />

		<field name="client_id" type="sql" default="" onchange="this.form.submit();"
			header="COM_MOTHERSHIP_FILTER_SELECT_CLIENT" key_field="value" value_field="text"
			query="SELECT id AS value, name AS text FROM #__mothership_clients ORDER BY name ASC"
			label="COM_MOTHERSHIP_INVOICES_FILTER_CLIENT_LABEL" description="" />

		<field name="account_id" type="accountfilter" default="" onchange="this.form.submit();"
			label="COM_MOTHERSHIP_INVOICES_FILTER_ACCOUNT_LABEL" description="" />
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" statuses="*,0,1,2,-2" class="js-select-submit-on-change" default="i.created DESC" validate="options">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="i.created DESC">Invoice date (newest first)</option>
			<option value="i.created ASC">Invoice date (oldest first)</option>
			<option value="i.number DESC">Invoice number (high to low)</option>
			<option value="i.number ASC">Invoice number (low to high)</option>
			<option value="i.total DESC">Total (high to low)</option>
			<option value="i.total ASC">Total (low to high)</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" class="js-select-submit-on-change" />
	</fields>
</form>
